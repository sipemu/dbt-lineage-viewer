{
  "name": "dbt-lineage-viewer",
  "displayName": "dbt-lineage: lineage & impact for dbt",
  "description": "See what your dbt change breaks (downstream models, columns, dashboards, contracts) before CI does. Plus hover, go-to-definition and lint for ref()/source(). Binary bundled; no warehouse, no Python.",
  "version": "0.2.1",
  "dbtLineageVersion": "0.16.0",
  "publisher": "sipemu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sipemu/dbt-lineage-viewer",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/sipemu/dbt-lineage-viewer/issues"
  },
  "homepage": "https://github.com/sipemu/dbt-lineage-viewer/blob/master/editors/vscode/README.md",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "dbt",
    "dbt-core",
    "lineage",
    "impact analysis",
    "data lineage",
    "column lineage",
    "sql",
    "jinja",
    "exposures",
    "data contracts",
    "data engineering",
    "analytics engineering",
    "language server"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbt-lineage.showImpact",
        "title": "dbt-lineage: Show impact of my changes",
        "icon": "$(git-compare)"
      },
      {
        "command": "dbt-lineage.showLineage",
        "title": "dbt-lineage: Show lineage"
      },
      {
        "command": "dbt-lineage.restartServer",
        "title": "dbt-lineage: Restart language server"
      }
    ],
    "configuration": {
      "title": "dbt-lineage",
      "properties": {
        "dbtLineage.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a `dbt-lineage` binary (a version that provides `dbt-lineage lsp`). Empty: use the binary bundled with the extension, or `dbt-lineage` on `PATH` when none is bundled."
        },
        "dbtLineage.baseRef": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Git ref that *Show impact of my changes* compares the working tree against. `auto`: the remote's default branch (`origin/HEAD`), else `main`, else `master`."
        },
        "dbtLineage.impactOnSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Refresh the impact panel whenever a file in the dbt project is saved (only while the panel is open)."
        },
        "dbtLineage.lineageDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "description": "Upstream and downstream levels shown by \"dbt-lineage: Show lineage\"."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node scripts/build.mjs --production",
    "compile": "tsc -p ./ --noEmit && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "fetch-binary": "node scripts/fetch-binary.mjs",
    "package": "node scripts/package.mjs",
    "test:impact": "node scripts/test-impact.mjs"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "mermaid": "^12.3.0",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0",
    "typescript": "^5.4.0"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0b5cad",
    "theme": "dark"
  }
}
